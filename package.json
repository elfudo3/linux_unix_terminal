{
  "name": "terminal-trainer",
  "version": "1.0.0",
  "description": "Practise Linux/Unix terminal commands in a simulated shell: desktop web app and iOS/Android app.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run dev -w apps/mobile",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "build:web": "npm run build -w apps/web",
    "build:mobile": "npm run build -w apps/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mobile:sync": "npm run sync -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
